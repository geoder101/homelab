#!/usr/bin/env bash
# CPU-only benchmark client; run on Brain while the selected backend is ready.
set -euo pipefail
root="$(dirname "$(dirname "$(realpath "$0")")")"
url="${1:?Usage: benchmark-coder-repeats URL LABEL [SEEDS ...]}"
label="${2:?Missing result label}"
shift 2
if (($# == 0)); then set -- 42 43 44; fi
status=0
for seed in "$@"; do
  podman run --rm --pull never --name ai-station-model-repeat \
    --network ai-station --memory 2g --cpus 4 \
    --security-opt no-new-privileges --cap-drop all \
    --volume "${root}/scripts/benchmark-coder:/benchmark.py:ro,z" \
    --volume "${root}/docs/benchmarks:/results:z" --entrypoint python3 \
    docker.io/vllm/vllm-openai@sha256:6ee133356d49ed24cee03dd0cda3d3980279a11c107ce3e752c89e76540f41c9 \
    /benchmark.py --url "${url}" --backend llama --label "${label}-seed${seed}" \
    --preserve-thinking --extended --contexts '' --max-tokens 16384 --seed "${seed}" \
    --thinking-budget "${THINKING_BUDGET:-8192}" \
    --output "/results/${label}-seed${seed}.json" || status=1
done
exit "${status}"
