#!/usr/bin/env bash
set -euo pipefail

case "${1:-q4}" in
  q4)
    directory=ornith-1.5-35b-gguf
    file=Ornith-1.5-35B-Q4_K_M.gguf
    sha=42739874cc2ccfdb8523b23fbe52e29b2a7555c8176737ca9ca0b5d59859d41f
    ;;
  q5)
    directory=ornith-1.5-35b-gguf-q5
    file=Ornith-1.5-35B-Q5_K_M.gguf
    sha=91df97de5845100e850b4b5ec5ff35695382020b880fad6f7f51787b3a953bd0
    ;;
  *) printf 'Usage: %s [q4|q5]\n' "$0" >&2; exit 2 ;;
esac
model_dir="${HOME}/.local/share/ai-station/models/${directory}"
install -d -m 700 "${model_dir}"
# The download harness reuses the pinned vLLM image only for its `hf` CLI; it
# never serves a backend here. `make deploy`/`pull` fetch it up front, but run
# `scripts/pull-images` first if invoking this script standalone.
podman run --rm --pull never --name ai-station-ornith-download \
  --entrypoint /usr/local/bin/hf \
  --volume "${model_dir}:/models/candidate:Z" \
  docker.io/vllm/vllm-openai@sha256:6ee133356d49ed24cee03dd0cda3d3980279a11c107ce3e752c89e76540f41c9 \
  download ornith-ai/Ornith-1.5-35B-A3B-GGUF \
  "${file}" mmproj-Ornith-1.5-35B-BF16.gguf \
  --revision 12393612fd4f730ff5aadc23e9b8f9648aa49ceb --local-dir /models/candidate

printf '%s  %s\n' "${sha}" "${model_dir}/${file}" | sha256sum --check
printf '%s  %s\n' 1921a36a85aee56cd2abd27f46701802c9d85a33474792e600df6c3b282a135d \
  "${model_dir}/mmproj-Ornith-1.5-35B-BF16.gguf" | sha256sum --check
python3 "$(dirname "$(realpath "$0")")/download-ornith-template"
