#!/usr/bin/env python3
"""Run bounded local GPU candidates; always remove the candidate and restore service.

Host Python + PyYAML required. Results/logs contain synthetic prompts, no keys.
The deployed Quadlets, gateway routing and client configuration are not edited.
"""
import argparse
import datetime
import fcntl
import json
import pathlib
import shlex
import signal
import subprocess
import threading
import time

import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent
NAME = 'ai-station-coder-candidate'
PROFILES = {
    'baseline': [],
    'q8-pool256': ['--parallel', '2', '--kv-unified', '--kv-unified-per-slot', '262144', '--cache-ram', '16384'],
    'q8-pool320': ['--parallel', '2', '--ctx-size', '327680', '--kv-unified', '--kv-unified-per-slot', '262144', '--cache-ram', '16384'],
    'q8-pool384': ['--parallel', '2', '--ctx-size', '393216', '--kv-unified', '--kv-unified-per-slot', '262144', '--cache-ram', '16384'],
    'q8-pool512': ['--parallel', '2', '--ctx-size', '524288', '--kv-unified', '--kv-unified-per-slot', '262144', '--cache-ram', '16384'],
    'q8q4-pool512': ['--parallel', '2', '--ctx-size', '524288', '--kv-unified', '--kv-unified-per-slot', '262144', '--cache-type-v', 'q4_0', '--cache-ram', '16384'],
    'q4-pool512': ['--parallel', '2', '--ctx-size', '524288', '--kv-unified', '--kv-unified-per-slot', '262144', '--cache-type-k', 'q4_0', '--cache-type-v', 'q4_0', '--cache-ram', '16384'],
    'q8-projector-cpu': ['--parallel', '2', '--ctx-size', '393216', '--kv-unified', '--kv-unified-per-slot', '262144', '--no-mmproj-offload', '--cache-ram', '16384'],
    'q8-layers-cpu': ['--parallel', '2', '--ctx-size', '524288', '--kv-unified', '--kv-unified-per-slot', '262144', '--n-gpu-layers', '56', '--cache-ram', '16384'],
    'q8-kv-cpu': ['--parallel', '2', '--ctx-size', '524288', '--kv-unified', '--kv-unified-per-slot', '262144', '--no-kv-offload', '--cache-ram', '16384'],
    'q8-small-batch384': ['--parallel', '2', '--ctx-size', '393216', '--kv-unified', '--kv-unified-per-slot', '262144', '--ubatch-size', '128', '--cache-ram', '16384'],
    'q8q4-small-batch512': ['--parallel', '2', '--ctx-size', '524288', '--kv-unified', '--kv-unified-per-slot', '262144', '--ubatch-size', '128', '--cache-type-v', 'q4_0', '--cache-ram', '16384'],
    'q8-layers48-cpu': ['--parallel', '2', '--ctx-size', '524288', '--kv-unified', '--kv-unified-per-slot', '262144', '--n-gpu-layers', '48', '--cache-ram', '16384'],
    'q4-fixed2': ['--parallel', '2', '--ctx-size', '524288', '--no-kv-unified', '--cache-type-k', 'q4_0', '--cache-type-v', 'q4_0', '--cache-ram', '16384'],
    'q8q4-fixed2': ['--parallel', '2', '--ctx-size', '524288', '--no-kv-unified', '--cache-type-v', 'q4_0', '--cache-ram', '16384'],
    'q5q4-fixed2': ['--parallel', '2', '--ctx-size', '524288', '--no-kv-unified', '--cache-type-k', 'q5_0', '--cache-type-v', 'q4_0', '--cache-ram', '16384'],
    'q5-fixed2': ['--parallel', '2', '--ctx-size', '524288', '--no-kv-unified', '--cache-type-k', 'q5_0', '--cache-type-v', 'q5_0', '--cache-ram', '16384'],
    'helper-cpu8': ['--n-gpu-layers', '0', '--device', 'none', '--threads', '8', '--threads-batch', '8'],
    'helper-cpu16': ['--n-gpu-layers', '0', '--device', 'none', '--threads', '16', '--threads-batch', '16'],
    'helper-gpu': ['--n-gpu-layers', '99'],
    'q4-pool512-slots4': ['--parallel', '4', '--ctx-size', '524288', '--kv-unified', '--kv-unified-per-slot', '262144', '--cache-type-k', 'q4_0', '--cache-type-v', 'q4_0', '--cache-ram', '16384'],
    'q3-weights-q8q4-fixed2': ['--model', '/models/weights/Qwen3.8-27B-UD-Q3_K_XL.gguf', '--parallel', '2', '--ctx-size', '524288', '--no-kv-unified', '--cache-type-v', 'q4_0', '--cache-ram', '16384'],
    'q3-weights-q4-fixed3': ['--model', '/models/weights/Qwen3.8-27B-UD-Q3_K_XL.gguf', '--parallel', '3', '--ctx-size', '786432', '--no-kv-unified', '--cache-type-k', 'q4_0', '--cache-type-v', 'q4_0', '--cache-ram', '16384'],
    'q3-projector-cpu-fixed3': ['--model', '/models/weights/Qwen3.8-27B-UD-Q3_K_XL.gguf', '--parallel', '3', '--ctx-size', '786432', '--no-kv-unified', '--cache-type-k', 'q4_0', '--cache-type-v', 'q4_0', '--no-mmproj-offload', '--cache-ram', '16384'],
    'vllm-nvfp4-kv': ['--kv-cache-dtype', 'nvfp4'],
    'vllm-nvfp4-graphs': ['--kv-cache-dtype', 'nvfp4'],
    'vllm-fp8-offload4': ['--kv-cache-dtype', 'fp8_e4m3', '--cpu-offload-gb', '4'],
}


def command(*args, check=True, **kwargs):
    return subprocess.run(list(args), check=check, text=True, capture_output=True, **kwargs)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--profiles', default='baseline,q8-pool320,q4-fixed2,q3-projector-cpu-fixed3',
        help='Comma-separated candidates: ' + ', '.join(PROFILES))
    parser.add_argument('--mode', choices=['screen', 'long', 'full', 'boundary', 'quality', 'extended'], default='screen')
    parser.add_argument('--repeats', type=int, default=1)
    parser.add_argument('--output-dir', required=True)
    parser.add_argument('--client-timeout', type=int, default=1500)
    args = parser.parse_args()
    names = args.profiles.split(',')
    for name in names:
        if name not in PROFILES:
            parser.error(f'Unknown profile: {name}')
    lock = (pathlib.Path.home() / '.local/share/ai-station/tune-concurrency.lock').open('a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit('Another concurrency controller is running')
    out = pathlib.Path(args.output_dir).resolve()
    out.mkdir(parents=True, exist_ok=True)
    unit = (ROOT / 'quadlets/llama-coder.container').read_text().splitlines()
    image = next(l.split('=', 1)[1] for l in unit if l.startswith('Image='))
    mounts = [l.split('=', 1)[1].replace('%h', str(pathlib.Path.home())) for l in unit if l.startswith('Volume=')]
    base = shlex.split(next(l.split('=', 1)[1] for l in unit if l.startswith('Exec=')))
    candidate_locks = yaml.safe_load((ROOT / 'config/candidates.lock.yaml').read_text())['candidates']
    original = candidate_locks['qwen38_gguf']
    template = yaml.safe_load((ROOT / 'config/chat-templates.lock.yaml').read_text())['qwen_fixed']
    mounts = [str(pathlib.Path.home() / '.local/share/ai-station/models' / original['directory']) + ':/models/coder:ro,Z',
        str(pathlib.Path.home() / '.local/share/ai-station' / template['directory']) + ':/templates:ro,Z']
    # Do not inherit a tuned deployment's scheduling when rerunning historical candidates.
    for flag in ('--kv-unified', '--no-kv-unified', '--cache-idle-slots', '--no-cache-idle-slots', '--no-mmproj-offload', '--no-kv-offload'):
        while flag in base:
            base.remove(flag)
    for flag in ('--kv-unified-per-slot', '--cache-ram'):
        if flag in base:
            index = base.index(flag)
            del base[index:index+2]
    for flag, value in [('--model', '/models/coder/' + original['file']),
                        ('--mmproj', '/models/coder/' + original['vision_file']),
                        ('--parallel', '1'), ('--ctx-size', '262144'),
                        ('--cache-type-k', 'q8_0'), ('--cache-type-v', 'q8_0'), ('--n-gpu-layers', '99')]:
        index = base.index(flag)
        base[index+1] = value
    if command('podman', 'container', 'exists', NAME, check=False).returncode == 0:
        raise SystemExit('Existing candidate container: stop/remove it explicitly first')
    if command('systemctl', '--user', 'is-active', '--quiet', 'vllm-coder', check=False).returncode == 0:
        raise SystemExit('vllm-coder active; select the default backend before this experiment')
    helper_run = all(name.startswith('helper-') for name in names)
    if any(name.startswith('helper-') for name in names) and not helper_run:
        parser.error('Run helper profiles separately; they retain the production main model')
    if 'helper-gpu' in names and len(names) != 1:
        parser.error('Run GPU helper alone, with the production backend stopped')
    restore = (not helper_run or names == ['helper-gpu']) and command('systemctl', '--user', 'is-active', '--quiet', 'llama-coder', check=False).returncode == 0
    def interrupted(signum, frame):
        raise KeyboardInterrupt(f'signal {signum}')
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    def stop_candidate():
        command('podman', 'rm', '--force', NAME, check=False, timeout=60)
    try:
        if restore:
            command('systemctl', '--user', 'stop', 'llama-coder', timeout=180)
        for name in names:
            extra = PROFILES[name]
            cmd = base + extra + ['--log-verbosity', '4']
            candidate_image = image
            candidate_mounts = mounts
            backend = 'llama'
            if name.startswith('q3-'):
                candidate_mounts = mounts + [str(pathlib.Path.home() / '.local/share/ai-station/models/qwen3.8-27b-gguf-q3') + ':/models/weights:ro,Z']
            if name.startswith('vllm-'):
                backend = 'vllm'
                candidate_image = yaml.safe_load((ROOT / 'config/candidates.lock.yaml').read_text())['candidates']['qwen38_nvfp4']['image']
                candidate_mounts = [str(pathlib.Path.home() / '.local/share/ai-station/models/qwen3.8-27b-nvfp4') + ':/models/candidate:ro,Z', mounts[1]]
                cmd = ['/models/candidate', '--served-model-name', 'coder', '--host', '0.0.0.0', '--port', '8000',
                    '--gpu-memory-utilization', '0.94', '--max-model-len', '262144', '--max-num-seqs', '2',
                    '--max-num-batched-tokens', '2048', '--enforce-eager',
                    '--enable-auto-tool-choice', '--tool-call-parser', 'qwen3_xml', '--reasoning-parser', 'qwen3',
                    '--chat-template', '/templates/chat_template.jinja',
                    '--default-chat-template-kwargs', '{"reasoning_effort":"medium","preserve_thinking":true}'] + extra
                if name == 'vllm-nvfp4-graphs':
                    cmd.remove('--enforce-eager')
            if helper_run:
                cmd = ['--model', '/models/helper/Qwen3.5-4B-Q4_K_M.gguf',
                    '--alias', 'coder', '--host', '0.0.0.0', '--port', '8000',
                    '--ctx-size', '65536', '--parallel', '1', '--flash-attn', 'on',
                    '--cache-type-k', 'q8_0', '--cache-type-v', 'q8_0', '--jinja',
                    '--reasoning-format', 'deepseek', '--log-verbosity', '4'] + extra
            result = {'profile': name, 'mode': args.mode, 'timestamp': datetime.datetime.now(datetime.timezone.utc).isoformat(),
                'image': candidate_image, 'arguments': cmd, 'samples': [], 'tests': []}
            stop = threading.Event()
            def sample():
                while not stop.is_set():
                    gpu = command('nvidia-smi', '--query-gpu=memory.used,memory.free,utilization.gpu', '--format=csv,noheader,nounits', check=False)
                    mem = {line.split(':')[0]: int(line.split()[1]) for line in pathlib.Path('/proc/meminfo').read_text().splitlines() if line.startswith(('MemAvailable:', 'SwapFree:'))}
                    result['samples'].append({'monotonic': time.monotonic(), 'gpu': gpu.stdout.strip(), **mem})
                    stop.wait(1)
            monitor = threading.Thread(target=sample, daemon=True)
            monitor.start()
            started = time.monotonic()
            try:
                launch = ['podman', 'run', '-d', '--pull', 'never', '--name', NAME,
                    '--network', 'ai-station', '--network-alias', 'coder-candidate',
                    '--shm-size', '8g']
                if not name.startswith('helper-cpu'):
                    launch += ['--device', 'nvidia.com/gpu=all', '--security-opt', 'label=disable']
                selected_mounts = candidate_mounts if not helper_run else [str(pathlib.Path.home() / '.local/share/ai-station/models/qwen35-4b-helper') + ':/models/helper:ro,Z']
                for mount in selected_mounts:
                    launch += ['--volume', mount]
                command(*launch, candidate_image, *cmd, timeout=60)
                ready = False
                for _ in range(180):
                    status = command('podman', 'inspect', '--format', '{{.State.Running}}', NAME, check=False).stdout.strip()
                    if status != 'true':
                        break
                    health = command('podman', 'exec', 'ai-station-litellm', 'python', '-c',
                        'import urllib.request; urllib.request.urlopen("http://coder-candidate:8000/health",timeout=2).read()', check=False, timeout=10)
                    if health.returncode == 0:
                        ready = True
                        break
                    time.sleep(2)
                result['ready'] = ready
                result['startup_seconds'] = round(time.monotonic()-started, 3)
                if ready and args.mode in ('quality', 'extended'):
                    quality = command('podman', 'run', '--rm', '--pull', 'never',
                        '--network', 'ai-station', '--memory', '2g', '--cpus', '4',
                        '--security-opt', 'no-new-privileges', '--cap-drop', 'all',
                        '--volume', str(ROOT / 'scripts/benchmark-coder') + ':/benchmark.py:ro,z',
                        '--volume', str(out) + ':/results:z', '--entrypoint', 'python3',
                        'docker.io/vllm/vllm-openai@sha256:6ee133356d49ed24cee03dd0cda3d3980279a11c107ce3e752c89e76540f41c9',
                        '/benchmark.py', '--backend', backend, '--label', name,
                        '--contexts', '', '--preserve-thinking', '--thinking-budget', '2048' if helper_run else '6144',
                        '--output', f'/results/{name}-{args.mode}-coding.json',
                        *(['--extended'] if args.mode == 'extended' else []), check=False, timeout=args.client_timeout)
                    result['quality_returncode'] = quality.returncode
                    result['tests'] = [json.loads(line) for line in quality.stdout.splitlines() if line.startswith('{')]
                    result['client_stderr'] = quality.stderr[-4000:]
                elif ready:
                    client = command('podman', 'exec', '-i', 'ai-station-litellm', 'python', '-',
                        '--mode', args.mode, '--repeats', str(args.repeats), '--backend', backend,
                        '--slots', '4' if name.endswith('slots4') else '3' if name.endswith('fixed3') else '2',
                        input=(ROOT / 'scripts/benchmark-concurrency').read_text(), timeout=args.client_timeout, check=False)
                    result['tests'] = [json.loads(line) for line in client.stdout.splitlines() if line.startswith('{')]
                    result['client_returncode'] = client.returncode
                    result['client_stderr'] = client.stderr[-4000:]
                    if helper_run and name.startswith('helper-cpu'):
                        # Separate server processes, same GPU main profile. Both clients run together.
                        helper = subprocess.Popen(['podman', 'exec', '-i', 'ai-station-litellm', 'python', '-'],
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                        helper.stdin.write((ROOT / 'scripts/benchmark-concurrency').read_text())
                        helper.stdin.close()
                        time.sleep(2)
                        main_client = command('podman', 'exec', '-i', 'ai-station-litellm', 'python', '-',
                            '--url', 'http://llama-coder:8000', input=(ROOT / 'scripts/benchmark-concurrency').read_text(), timeout=240)
                        result['main_during_helper'] = [json.loads(line) for line in main_client.stdout.splitlines() if line.startswith('{')]
                        helper.stdin = None
                        helper_stdout, helper_stderr = helper.communicate(timeout=240)
                        result['helper_concurrent_stdout'] = helper_stdout
                        result['helper_concurrent_stderr'] = helper_stderr
            except (Exception, KeyboardInterrupt) as error:
                result['error'] = str(error)
                if isinstance(error, KeyboardInterrupt):
                    raise
            finally:
                stop.set()
                monitor.join(timeout=15)
                logs = command('podman', 'logs', NAME, check=False)
                (out / f'{name}-{args.mode}.log').write_text(logs.stdout + logs.stderr)
                result['elapsed_seconds'] = round(time.monotonic()-started, 3)
                (out / f'{name}-{args.mode}.json').write_text(json.dumps(result, indent=2))
                stop_candidate()
                print(json.dumps({'profile': name, 'ready': result.get('ready'), 'seconds': result['elapsed_seconds'],
                    'tests': [{k:t[k] for k in ('name', 'passed', 'wall_seconds', 'error') if k in t} for t in result['tests']],
                    'error': result.get('error')}), flush=True)
    finally:
        stop_candidate()
        if restore:
            command('systemctl', '--user', 'start', 'llama-coder', timeout=900)
            print('Original deployed llama-coder service start requested.', flush=True)


if __name__ == '__main__':
    main()
