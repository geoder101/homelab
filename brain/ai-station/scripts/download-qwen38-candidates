#!/usr/bin/env bash
set -euo pipefail

image="docker.io/vllm/vllm-openai@sha256:6ee133356d49ed24cee03dd0cda3d3980279a11c107ce3e752c89e76540f41c9"
case "${1:-}" in
  nvfp4)
    repository="unsloth/Qwen3.8-27B-NVFP4"
    revision="f0b7c9e722f5565102fff8481c99e4d86ae099c7"
    model_dir="${HOME}/.local/share/ai-station/models/qwen3.8-27b-nvfp4"
    files=()
    ;;
  gguf|vision)
    repository="unsloth/Qwen3.8-27B-GGUF"
    revision="4ca720788d1e01f1bff70c033e0d0028fd02e502"
    model_dir="${HOME}/.local/share/ai-station/models/qwen3.8-27b-gguf"
    files=(Qwen3.8-27B-UD-Q4_K_XL.gguf mmproj-BF16.gguf)
    if [[ "$1" == vision ]]; then files=(mmproj-BF16.gguf); fi
    ;;
  *)
    printf 'Usage: %s nvfp4|gguf|vision\n' "$0" >&2
    exit 2
    ;;
esac

install -d -m 700 "${model_dir}"
podman run --rm --pull never \
  --entrypoint /usr/local/bin/hf \
  --volume "${model_dir}:/models/candidate:Z" \
  "${image}" download "${repository}" "${files[@]}" --revision "${revision}" \
  --local-dir /models/candidate
