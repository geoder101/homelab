#!/usr/bin/env bash
set -euo pipefail
root="$(dirname "$(dirname "$(realpath "$0")")")"
url="${1:?Usage: benchmark-coder-concurrency URL LABEL}"
label="${2:?Missing result label}"
status=0
if [[ "${3:-}" != --agent-only ]]; then
for mode in screen full limit; do
  podman run --rm --pull never --name ai-station-model-concurrency \
    --network ai-station --memory 2g --cpus 4 \
    --security-opt no-new-privileges --cap-drop all \
    --volume "${root}/scripts/benchmark-concurrency:/benchmark.py:ro,z" \
    --entrypoint python3 \
    docker.io/vllm/vllm-openai@sha256:6ee133356d49ed24cee03dd0cda3d3980279a11c107ce3e752c89e76540f41c9 \
    /benchmark.py --url "${url}" --mode "${mode}" --slots 2 --repeats 3 \
    | tee "${root}/docs/benchmarks/${label}-${mode}.jsonl" || status=1
done
fi
podman run --rm --pull never --name ai-station-model-concurrency \
  --network ai-station --memory 2g --cpus 4 \
  --security-opt no-new-privileges --cap-drop all \
  --volume "${root}/scripts/benchmark-agent-repair:/benchmark.py:ro,z" \
  --volume "${root}/docs/benchmarks:/results:z" --entrypoint python3 \
  docker.io/vllm/vllm-openai@sha256:6ee133356d49ed24cee03dd0cda3d3980279a11c107ce3e752c89e76540f41c9 \
  /benchmark.py --url "${url}" --output "/results/${label}-agent-repair-v2.json" || status=1
exit "${status}"
