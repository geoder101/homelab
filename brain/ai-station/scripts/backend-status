#!/usr/bin/env python3
"""Report which backend is currently serving inference (read-only).

Prints one line:
  GPU: <profile>        llama-coder active (with the selected profile)
  CPU: fallback         llama-fallback active (GPU backend down)
  DOWN: no active backend  neither backend is running

It probes `systemctl --user is-active` only, so it is safe to run while the GPU
backend is temporarily down (e.g. reassigned to another task) and changes no
service. When the GPU backend is active the profile name is read from the
selected model lock, matching `switch-coder-profile --status`.
"""
import pathlib
import subprocess
import sys
import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent


def active(name):
    return subprocess.run(['systemctl', '--user', 'is-active', '--quiet', name]).returncode == 0


def profile():
    try:
        current = yaml.safe_load((ROOT / 'config/models.lock.yaml').read_text())['models']['coder']
        return current.get('profile', 'custom')
    except (OSError, ValueError, KeyError):
        return None


def main():
    if active('llama-coder'):
        print(f"GPU: {profile()}")
    elif active('llama-fallback'):
        print("CPU: fallback")
    else:
        print("DOWN: no active backend")
    return 0


if __name__ == '__main__':
    sys.exit(main())
