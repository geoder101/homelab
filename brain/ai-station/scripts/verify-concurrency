#!/usr/bin/env python3
"""Verify deployed concurrent streaming through LiteLLM, using synthetic prompts."""
import argparse
import json
import pathlib
import subprocess

import yaml

root = pathlib.Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output', type=pathlib.Path)
parser.add_argument('--queue-check', action='store_true', help='Submit one request beyond available slots')
parser.add_argument('--limit-check', action='store_true', help='Reject an oversized per-agent context, then recover')
args = parser.parse_args()
profile = yaml.safe_load((root / 'config/models.lock.yaml').read_text())['models']['coder']
slots = profile.get('parallel', 1)
result = subprocess.run(['podman', 'exec', '-i', 'ai-station-litellm', 'python', '-',
    '--url', 'http://llama-coder:8000', '--gateway', 'http://127.0.0.1:4000',
    '--model', 'coder-off', '--slots', str(slots+int(args.queue_check)),
    '--repeats', '1' if args.queue_check else '3', '--mode', 'limit' if args.limit_check else 'screen'],
    input=(root / 'scripts/benchmark-concurrency').read_text(), capture_output=True, text=True, timeout=300)
tests = [json.loads(line) for line in result.stdout.splitlines() if line.startswith('{')]
if args.output:
    args.output.write_text(json.dumps({'profile': profile, 'tests': tests,
        'returncode': result.returncode, 'stderr': result.stderr}, indent=2))
assert result.returncode == 0, result.stderr or tests
runtime = next(t for t in tests if t['name'] == 'runtime')
assert runtime['slots'] == slots and runtime['n_ctx_slot'] == profile['context'], runtime
for test in tests:
    assert test['passed'], test
    if test['name'].startswith('pair_') and slots >= 2:
        assert test['max_active_slots'] == 2 and test['stream_overlap_seconds'] > 0, test
    if test['name'].startswith('group_'):
        assert test['max_active_slots'] == slots, test
        if args.queue_check:
            assert max(r['first_monotonic'] for r in test['requests']) >= min(r['finished_monotonic'] for r in test['requests'])-0.1, test
        else:
            assert test['stream_overlap_seconds'] > 0, test
    print(json.dumps({k:test[k] for k in ['name', 'passed', 'slots', 'n_ctx_slot',
        'ttft_seconds', 'decode_tps', 'aggregate_tps', 'max_active_slots', 'stream_overlap_seconds'] if k in test}))
print('Deployed LiteLLM concurrency: PASS')
