#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

while IFS= read -r image; do
  podman pull "${image}"
done < <(python3 - "${project_dir}/config/images.lock.yaml" <<'EOF'
import pathlib
import sys

import yaml

locks = yaml.safe_load(pathlib.Path(sys.argv[1]).read_text())['images']
for entry in locks.values():
    print(f"{entry['source']}@{entry['digest']}")
EOF
)
