#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
generator="/usr/lib/systemd/system-generators/podman-system-generator"

if [[ ! -x "${generator}" ]]; then
  printf 'Run this script on the Fedora host, not directly inside toolbox.\n' >&2
  exit 1
fi

QUADLET_UNIT_DIRS="${project_dir}/quadlets" "${generator}" --user --dryrun
