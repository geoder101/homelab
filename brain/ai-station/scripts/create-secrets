#!/usr/bin/env bash
set -euo pipefail

config_dir="${HOME}/.config/ai-station"
install -d -m 700 "${config_dir}"

if [[ -e "${config_dir}/litellm.env" || -e "${config_dir}/open-webui.env" ]]; then
  printf 'Refusing to overwrite existing secret files in %s\n' "${config_dir}" >&2
  exit 1
fi

litellm_key="sk-$(openssl rand -hex 32)"
webui_key="$(openssl rand -hex 32)"

umask 077
printf 'LITELLM_MASTER_KEY=%s\n' "${litellm_key}" > "${config_dir}/litellm.env"
printf 'WEBUI_SECRET_KEY=%s\nOPENAI_API_KEYS=%s\n' "${webui_key}" "${litellm_key}" > "${config_dir}/open-webui.env"
printf 'Created secret files in %s\n' "${config_dir}"
