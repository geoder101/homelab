#!/usr/bin/env python3
"""Install a pinned Ornith template with duplicate inline-history normalization."""
import hashlib
import os
import pathlib
import tempfile
import urllib.request

import yaml


def normalize_history(source):
    needle = '        {%- set reasoning_content = reasoning_content|trim %}'
    assert source.count(needle) == 1, 'Unexpected upstream template structure'
    fix = '''        {%- if content.startswith('<think>') and '</think>' in content %}
            {%- if not reasoning_content %}
                {%- set reasoning_content = content.split('</think>')[0].split('<think>')[-1].strip() %}
            {%- endif %}
            {%- set content = content.split('</think>', 1)[1].lstrip('\\n') %}
        {%- endif %}
'''
    return ('{# ornith1.5-history-v1: normalize inline thinking when metadata is also supplied #}\n'
            + source.replace(needle, fix + needle))


def main():
    root = pathlib.Path(__file__).resolve().parent.parent
    lock = yaml.safe_load((root / 'config/chat-templates.lock.yaml').read_text())['ornith_fixed']
    url = f"https://huggingface.co/{lock['repository']}/resolve/{lock['revision']}/{lock['file']}"
    with urllib.request.urlopen(url, timeout=120) as response:
        upstream = response.read()
    assert hashlib.sha256(upstream).hexdigest() == lock['upstream_sha256'], 'Upstream checksum mismatch'
    result = normalize_history(upstream.decode()).encode()
    assert hashlib.sha256(result).hexdigest() == lock['sha256'], 'Patched template checksum mismatch'
    directory = pathlib.Path.home() / '.local/share/ai-station' / lock['directory']
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temporary = tempfile.mkstemp(dir=directory, prefix='.template-')
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(result)
        os.replace(temporary, directory / lock['file'])
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print(f"Verified Ornith history template: {directory / lock['file']}")


if __name__ == '__main__':
    main()
