                          "max_tokens": args.max_tokens, "seed": args.seed,
                          "sampling_profile": args.sampling_profile, "mtp": False}, "tests": []}


def sampling(thinking, tools=False):
    values = {'temperature': 1.0 if thinking else .7, 'top_p': .95 if thinking else .8,
              'top_k': 20, 'min_p': 0.0, 'presence_penalty': 0.0 if thinking else 1.5,
              'repeat_penalty': 1.0}
    if args.sampling_profile == 'qwen3-coder':
        values.update(temperature=.7, top_p=.8, presence_penalty=0.0, repeat_penalty=1.05)
    elif args.sampling_profile == 'glm47':
        values.update(temperature=.7 if tools or not thinking else 1.0,
                      top_p=1.0 if tools or not thinking else .95,
                      top_k=0, min_p=.01, presence_penalty=0.0)
    elif args.sampling_profile == 'gemma4':
        values.update(temperature=1.0, top_p=.95, top_k=64, presence_penalty=0.0)
    elif args.sampling_profile == 'devstral2':
        values.update(temperature=.15, top_p=1.0, top_k=0, presence_penalty=0.0)
    elif args.sampling_profile == 'gptoss':
        values.update(temperature=1.0, top_p=1.0, top_k=0, presence_penalty=0.0)
    elif args.sampling_profile == 'general':
        values.update(temperature=1.0, top_p=.95, top_k=20, presence_penalty=0.0)
    if args.backend != 'llama':
        values['repetition_penalty'] = values.pop('repeat_penalty')
        if values['top_k'] == 0:
            values['top_k'] = -1
    return values


results['settings']['sampling'] = {mode: sampling(thinking, tools) for mode, thinking, tools in
                                  [('coding', True, False), ('tools', True, True), ('streaming', False, False)]}


def post(path, body, timeout=600):
    request = urllib.request.Request(
        args.url + path, data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
    )
    try:
        return urllib.request.urlopen(request, timeout=timeout)
    except urllib.error.HTTPError as error:
        raise RuntimeError(f"HTTP {error.code}: {error.read().decode()}") from error


def request_chat(messages, *, thinking=True, max_tokens=None, **extra):
    thinking = thinking and args.sampling_profile not in ('qwen3-coder', 'devstral2')
    body = {
        "model": "coder", "messages": messages, "seed": args.seed,
        "temperature": 1.0 if thinking else 0.7,
        "top_p": 0.95 if thinking else 0.8,
        "top_k": 20, "min_p": 0.0,
        "presence_penalty": 0.0 if thinking else 1.5,
        "repetition_penalty": 1.0,
        "max_tokens": args.max_tokens if max_tokens is None else max_tokens,
        "chat_template_kwargs": {
            "enable_thinking": thinking, "reasoning_effort": "medium",
            "preserve_thinking": args.preserve_thinking,
        },
        **extra,
    }
    if args.backend == 'llama':
        body['reasoning_budget_tokens'] = args.thinking_budget if thinking else 0
        body.pop('repetition_penalty', None)
    body.update(sampling(thinking, bool(extra.get('tools'))))
    if args.sampling_profile == 'gptoss':
        body['reasoning_effort'] = 'medium' if thinking else 'low'
        body['chat_template_kwargs']['reasoning_effort'] = body['reasoning_effort']
    start = time.monotonic()
    with post("/v1/chat/completions", body) as response:
        value = json.load(response)
    return value, round(time.monotonic() - start, 3)


def record(name, test):
    try:
        result = {"name": name, "passed": True, **test()}
    except Exception as error:
        result = {"name": name, "passed": False, "error": str(error)}
    results["tests"].append(result)
    print(json.dumps({key: value for key, value in result.items()
                      if key not in {"answer", "code"}}), flush=True)
    with open(args.output, "w") as output:
        json.dump(results, output, indent=2)


def streaming_speed():
    body = {
        "model": "coder", "stream": True, "stream_options": {"include_usage": True},
        "seed": args.seed, "temperature": 0.7, "top_p": 0.8, "top_k": 20,
        "presence_penalty": 1.5, "max_tokens": 1024 if args.sampling_profile == 'gptoss' else 512,
        "chat_template_kwargs": {"enable_thinking": False},
        "messages": [{"role": "user", "content": (
            "Write a detailed checklist for diagnosing a Python HTTP server that leaks "
            "memory during long-running integration tests. Give concrete checks and "
            "commands, covering profiling, resource cleanup and verification."
        )}],
    }
    body.update(sampling(False))
    if args.backend == 'llama':
        body['reasoning_budget_tokens'] = 0
    if args.sampling_profile == 'gptoss':
        body['reasoning_effort'] = 'low'
        body['chat_template_kwargs']['reasoning_effort'] = 'low'
    start = time.monotonic()
    first = None
    first_generated = None
    usage = {}
    pieces = []
    with post("/v1/chat/completions", body) as response:
        for raw in response:
            if not raw.startswith(b"data: ") or raw.strip() == b"data: [DONE]":
                continue
            event = json.loads(raw[6:])
            usage = event.get("usage") or usage
            for choice in event.get("choices", []):
                delta = choice.get('delta', {})
                text = delta.get("content")
                if (text or delta.get('reasoning_content') or delta.get('reasoning')) and first_generated is None:
                    first_generated = time.monotonic()
                if text:
                    if first is None:
                        first = time.monotonic()
                    pieces.append(text)
    finish = time.monotonic()
    assert first is not None, "No streamed text"
    return {"ttft_seconds": round(first - start, 3),
             "elapsed_seconds": round(finish - start, 3), "usage": usage,
             "first_generated_token_seconds": round(first_generated - start, 3),
             "max_tokens": body['max_tokens'],
             "decode_tokens_per_second": round(usage["completion_tokens"] / (finish - first_generated), 2),
            "answer": "".join(pieces)}


