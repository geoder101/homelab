def constrain_child():
    resource.setrlimit(resource.RLIMIT_CPU, (3, 3))
    resource.setrlimit(resource.RLIMIT_AS, (512 * 1024**2, 512 * 1024**2))


def coding(prompt, tests):
    response, elapsed = request_chat([
        {"role": "developer", "content": "You are a precise Python engineer. Follow the requested contract."},
        {"role": "user", "content": prompt},
    ])
    choice = response["choices"][0]
    code = choice["message"].get("content") or ""
    match = re.search(r"```(?:python)?\s*\n(.*?)```", code, re.S)
    if match:
        code = match.group(1)
    completed = subprocess.run(
        [sys.executable, "-I", "-c", code + "\n" + tests],
        capture_output=True, text=True, timeout=8, preexec_fn=constrain_child,
    )
    return {"passed": completed.returncode == 0, "elapsed_seconds": elapsed,
            "usage": response.get("usage"), "finish_reason": choice["finish_reason"],
            "code": code, "test_error": completed.stderr[-2000:]}


def tool_round_trip(seed):
    messages = [{"role": "user", "content": (
        'Use apply_changes to create src/a.py with content "print(42)\\n" and '
        'delete obsolete.txt. Set metadata.dry_run to true and metadata.labels to '
        '["coding", "test"]. Then report the tool result.'
    )}]
    tools = [{"type": "function", "function": {
        "name": "apply_changes", "description": "Apply the specified file operations.",
        "parameters": {"type": "object", "properties": {
            "changes": {"type": "array", "items": {"type": "object", "properties": {
                "path": {"type": "string"}, "operation": {"type": "string", "enum": ["create", "delete"]},
                "content": {"type": "string"}}, "required": ["path", "operation"]}},
            "metadata": {"type": "object", "properties": {
                "dry_run": {"type": "boolean"},
                "labels": {"type": "array", "items": {"type": "string"}}},
                "required": ["dry_run", "labels"]}}, "required": ["changes", "metadata"]},
    }}]
    response, elapsed = request_chat(messages, tools=tools, tool_choice="auto", seed=seed)
    message = response["choices"][0]["message"]
    call = message["tool_calls"][0]
    assert call["function"]["name"] == "apply_changes", call
    arguments = json.loads(call["function"]["arguments"])
    assert arguments["metadata"] == {"dry_run": True, "labels": ["coding", "test"]}, arguments
    changes = {item["path"]: item for item in arguments["changes"]}
    assert changes["src/a.py"]["operation"] == "create", changes
    assert changes["src/a.py"]["content"] == "print(42)\n", changes
    assert changes["obsolete.txt"]["operation"] == "delete", changes
    assistant = {"role": "assistant", "content": message.get("content"), "tool_calls": message["tool_calls"]}
    reasoning = message.get("reasoning_content") or message.get("reasoning")
    if reasoning:
        assistant["reasoning_content"] = reasoning
    messages += [assistant, {"role": "tool", "tool_call_id": call["id"],
                             "content": '{"status":"dry-run-ok","changed_files":2}'}]
    answer, second = request_chat(messages, tools=tools, tool_choice="auto", seed=seed)
    text = answer["choices"][0]["message"].get("content") or ""
    assert "2" in text or "two" in text.lower(), text
    return {"elapsed_seconds": round(elapsed + second, 3), "arguments": arguments, "answer": text}


def count_tokens(text):
    payload = ({"model": "coder", "prompt": text, "add_special_tokens": False}
               if args.backend == "vllm" else {"content": text, "add_special": False})
    with post("/tokenize", payload) as response:
        data = json.load(response)
    return data["count"] if "count" in data else len(data["tokens"])


def long_context(target):
    line = "// unrelated source context\n"
    per_line = count_tokens(line * 1000) / 1000
    n = int((target - 200) / per_line)
    text = (f"Source archive size {target}. Remember the exact values below.\n"
            "START_KEY=amber-7429\n" + line * (n // 2)
            + "MIDDLE_KEY=birch-5831\n" + line * (n - n // 2)
            + "END_KEY=cedar-9167\n"
            "Return only JSON with START_KEY, MIDDLE_KEY, END_KEY and their exact values.")
    messages = [{"role": "user", "content": text}]
    response, elapsed = request_chat(messages, thinking=False,
                                    max_tokens=2048 if args.sampling_profile == 'gptoss' else 256)
    text = response["choices"][0]["message"].get("content") or ""
    for expected in ["amber-7429", "birch-5831", "cedar-9167"]:
        assert expected in text, text
    assert response["usage"]["prompt_tokens"] >= target - 500, response["usage"]
    messages += [{"role": "assistant", "content": text},
                 {"role": "user", "content": "Now return only the value of MIDDLE_KEY."}]
    followup, followup_elapsed = request_chat(messages, thinking=False,
        max_tokens=1024 if args.sampling_profile == 'gptoss' else 128)
    followup_text = followup["choices"][0]["message"].get("content") or ""
    assert "birch-5831" in followup_text, followup_text
    return {"elapsed_seconds": elapsed, "usage": response["usage"], "answer": text,
            "followup_seconds": followup_elapsed, "followup_usage": followup["usage"]}


