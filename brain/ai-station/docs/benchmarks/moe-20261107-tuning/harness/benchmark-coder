    record(f"nested_tool_round_trip_{i + 1}", lambda i=i: tool_round_trip(args.seed + i))
for size in map(int, filter(None, args.contexts.split(","))):
    record(f"context_{size}", lambda size=size: long_context(size))
passed = sum(t["passed"] for t in results["tests"])
print(f"{args.label}: {passed}/{len(results['tests'])} functional checks passed", flush=True)
sys.exit(0 if passed == len(results["tests"]) else 1)
