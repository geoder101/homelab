parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--url", default="http://coder-candidate:8000")
parser.add_argument("--backend", choices=["vllm", "llama"], required=True)
parser.add_argument("--label", required=True)
parser.add_argument("--contexts", default="32000,122000,154000")
parser.add_argument("--output", required=True)
parser.add_argument("--preserve-thinking", action="store_true")
parser.add_argument("--thinking-budget", type=int, default=8192)
parser.add_argument("--max-tokens", type=int, default=8192)
parser.add_argument("--seed", type=int, default=42)
parser.add_argument("--sampling-profile", choices=["qwen", "qwen3-coder", "glm47", "gemma4", "general", "devstral2", "gptoss"], default="qwen")
parser.add_argument("--extended", action="store_true", help="Additional deployment/streaming contract tasks")
args = parser.parse_args()
