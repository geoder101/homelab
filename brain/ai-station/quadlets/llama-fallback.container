[Unit]
Description=AI Station llama.cpp coding fallback (CPU warm standby)
After=ai-station.network
Requires=ai-station.network

[Quadlet]
DefaultDependencies=false

[Container]
Image=ghcr.io/ggml-org/llama.cpp@sha256:ae676f2ecfdeb66db48b7c32f1f013c62cdbc3e380b1f6e8b425c981dd34ac99
ContainerName=ai-station-llama-fallback
Network=ai-station.network
NetworkAlias=llama-fallback
Volume=%h/.local/share/ai-station/models/qwen3-coder-30b-q4:/models/coder:ro,Z
Volume=%h/.local/share/ai-station/chat-templates/855bffc49448e299789730ff92c9b8d834d6cc14:/templates:ro,Z
# CPU warm standby for the coding aliases. Rides through GPU model swaps:
# when llama-coder is down, LiteLLM fails the coder-* aliases over here.
# Qwen3 Coder 30B-A3B MoE (3B active params) decodes far faster on CPU than
# the prior 27B dense Q3; --flash-attn speeds prefill. No GPU device,
# --n-gpu-layers 0. A single 65536 slot is a lighter footprint for a degraded
# CPU fallback (ctx-size 65536 / parallel 1, --cache-ram 8192). Text-only:
# no vision/mmproj.
Exec=--model /models/coder/Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf --alias fallback --host 0.0.0.0 --port 8001 --n-gpu-layers 0 --ctx-size 65536 --parallel 1 --no-kv-unified --cache-ram 8192 --cache-type-k q4_0 --cache-type-v q4_0 --jinja --flash-attn on --chat-template-file /templates/chat_template.jinja --chat-template-kwargs '{"enable_thinking":false,"preserve_thinking":false}' --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 --presence-penalty 0.0 --repeat-penalty 1.0 --no-webui --log-colors off
Pull=never
StopTimeout=60

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=15min

# On-demand: no [Install] section, so this unit does NOT autostart at boot.
# Start it with scripts/swap-coder-standby on before a GPU swap and stop it
# with ... off afterwards to free RAM. systemctl --user start/stop still work.
