[Unit]
Description=AI Station vLLM coding backend
After=ai-station.network
Requires=ai-station.network

[Quadlet]
# Images and model are local; do not wait for the host network-online target.
DefaultDependencies=false

[Container]
Image=docker.io/vllm/vllm-openai@sha256:6ee133356d49ed24cee03dd0cda3d3980279a11c107ce3e752c89e76540f41c9
ContainerName=ai-station-vllm-coder
Network=ai-station.network
NetworkAlias=vllm-coder
AddDevice=nvidia.com/gpu=all
# NVIDIA CDI mounts host driver libraries whose SELinux labels are not usable
# inside a confined rootless container. The container remains non-privileged.
SecurityLabelDisable=true
ShmSize=8g
Volume=%h/.local/share/ai-station/models:/models:Z
Volume=%h/.local/share/ai-station/huggingface:/root/.cache/huggingface:Z
Environment=HF_HOME=/root/.cache/huggingface
Environment=HF_HUB_DISABLE_TELEMETRY=1
# Bound concurrent sequences to keep hybrid-model CUDA graph profiling in 32 GiB.
# This checkpoint also selects FP8 KV under auto; make it explicit.
# 160K fits the measured GPU cache; native 256K requires more memory.
Exec=/models/qwen3.6-27b-nvfp4 --served-model-name coder --host 0.0.0.0 --port 8000 --gpu-memory-utilization 0.94 --max-model-len 163840 --kv-cache-dtype fp8_e4m3 --max-num-seqs 8 --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3
Pull=never
StopTimeout=120

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=15min

[Install]
WantedBy=default.target
