[Unit]
Description=AI Station Open WebUI
After=ai-station.network litellm.container
Requires=ai-station.network

[Quadlet]
DefaultDependencies=false

[Container]
Image=ghcr.io/open-webui/open-webui@sha256:c5354e4a8e83ae6e0c75521c494e7ca0e66ccd88421dcd625d618518cab181f1
ContainerName=ai-station-open-webui
Network=ai-station.network
PublishPort=3000:8080
Volume=%h/.local/share/ai-station/open-webui:/app/backend/data:Z
EnvironmentFile=%h/.config/ai-station/open-webui.env
Environment=WEBUI_NAME=Brain-AI-Station
Environment=ENABLE_OLLAMA_API=False
Environment=ENABLE_OPENAI_API=True
Environment=OPENAI_API_BASE_URLS=http://litellm:4000/v1
Pull=never
StopTimeout=30

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=5min

[Install]
WantedBy=default.target
