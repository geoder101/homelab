[Unit]
Description=AI Station llama.cpp coding backend
After=ai-station.network
Requires=ai-station.network

[Quadlet]
DefaultDependencies=false

[Container]
Image=ghcr.io/ggml-org/llama.cpp@sha256:ae676f2ecfdeb66db48b7c32f1f013c62cdbc3e380b1f6e8b425c981dd34ac99
ContainerName=ai-station-llama-coder
Network=ai-station.network
NetworkAlias=llama-coder
AddDevice=nvidia.com/gpu=all
SecurityLabelDisable=true
Volume=%h/.local/share/ai-station/models/qwen3.8-27b-gguf:/models/coder:ro,Z
# Single coding-agent slot; quantized K/V stays on GPU. MTP is disabled.
Exec=--model /models/coder/Qwen3.8-27B-UD-Q4_K_XL.gguf --mmproj /models/coder/mmproj-BF16.gguf --alias coder --host 0.0.0.0 --port 8000 --n-gpu-layers 99 --ctx-size 262144 --parallel 1 --flash-attn on --cache-type-k q8_0 --cache-type-v q8_0 --jinja --reasoning-format deepseek --chat-template-kwargs '{"reasoning_effort":"medium","preserve_thinking":false}' --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 --presence-penalty 0.0 --repeat-penalty 1.0 --no-webui --log-colors off
Pull=never
StopTimeout=120

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=15min

[Install]
WantedBy=default.target
