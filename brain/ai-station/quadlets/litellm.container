[Unit]
Description=AI Station LiteLLM gateway
After=ai-station.network vllm-coder.container
Requires=ai-station.network

[Quadlet]
# Serve locally even when the host network-online target is inactive.
DefaultDependencies=false

[Container]
Image=docker.litellm.ai/berriai/litellm@sha256:471f48b56221afba5adde2502b39a2596d04fa4ba30f2a82f002dd170fff4913
ContainerName=ai-station-litellm
Network=ai-station.network
NetworkAlias=litellm
PublishPort=0.0.0.0:4000:4000
Volume=%h/dev/projects/geoder101/ai-station/config/litellm-config.yaml:/app/config.yaml:ro,Z
EnvironmentFile=%h/.config/ai-station/litellm.env
Exec=--config /app/config.yaml --host 0.0.0.0 --port 4000
Pull=never
StopTimeout=30

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=5min

[Install]
WantedBy=default.target
